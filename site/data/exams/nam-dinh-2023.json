      "dapAn": ["B"],
      "goiY": ["Hàm số bậc nhất $y=ax+b$ đồng biến khi $a>0$."],
      "loiGiai": ["$y=x+3$ có $a=1>0$ nên đồng biến trên $\\mathbb R$. Chọn B."]
