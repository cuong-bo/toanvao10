      "loai": "tuluan",
      "deBai": "<p><b>Phần tự luận — Câu 1.</b> Chứng minh $\\sqrt{27}-2\\sqrt{12}+\\sqrt{4-2\\sqrt3}=-1$.</p>",
      "goiY": ["$\\sqrt{4-2\\sqrt3}=\\sqrt{(\\sqrt3-1)^2}=|\\sqrt3-1|$."],
      "loiGiai": [
