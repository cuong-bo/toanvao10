      "diem": 0.25,
      "loai": "tracnghiem",
      "deBai": "<p>Phương trình $2x^2-x-1=0$ có hai nghiệm $x_1<x_2$. Giá trị $2x_1+x_2$ bằng</p>",
      "phuongAn": [
