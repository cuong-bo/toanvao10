      "id": "c39",
      "soCau": 39,
      "chuyenDe": "phuong-trinh",
      "mucDo": 2,
      "diem": 0.2,
      "loai": "dapanso",
      "deBai": "<p>Giá trị của tham số $m$ để hệ phương trình $\\begin{cases}x+y=5m+1\\\\x+3y=5m+3\\end{cases}$ có nghiệm duy nhất $(x;y)$ thoả mãn $x-y=5$ là bao nhiêu? <span class=\"muted\">(Bản in gốc không có phương án đúng; hãy nhập giá trị tính được.)</span></p>",
      "dapAn": [
        "6/5",
        "1,2"
      ],
      "goiY": [
        "Trừ hai phương trình để tìm $y$; thay lại tìm $x$ theo $m$.",
        "Điều kiện $x-y=5$ cho phương trình theo $m$."
      ],
      "loiGiai": [
        "Trừ vế theo vế: $(x+3y)-(x+y)=2y=2 \\Rightarrow y=1$.",
        "Thay vào $x+y=5m+1$: $x=5m$.",
        "Điều kiện $x-y=5 \\Rightarrow 5m-1=5 \\Rightarrow m=\\dfrac65$.",
        "Vậy $m=\\dfrac65$ (bản in gốc không có phương án này)."
      ]
