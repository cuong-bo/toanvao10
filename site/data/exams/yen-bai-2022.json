      "mucDo": 3,
      "diem": 0.2,
      "loai": "tracnghiem",
      "deBai": "<p>Cho $(P):y=x^2$ và $(d):y=2mx-m+3$. Tìm $m$ để $(P)$ và $(d)$ cắt nhau tại hai điểm phân biệt có hoành độ $x_1,x_2$ thoả mãn $\\dfrac1{x_1}+\\dfrac1{x_2}=\\dfrac32$.</p>",
      "phuongAn": [
        {
          "ma": "A",
          "noiDung": "$m=6$"
        },
        {
          "ma": "B",
          "noiDung": "$m=9$"
        },
        {
          "ma": "C",
          "noiDung": "$m=-6$"
        },
        {
          "ma": "D",
          "noiDung": "$m=-9$"
        }
      ],
      "dapAn": [
        "D"
